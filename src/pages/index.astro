---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import settings from '../data/settings.json';
import { renderMarkdown } from '../lib/markdown';
import { telHref } from '../lib/urls';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home.md is missing');
const { Content } = await render(home);
const { title, description, heading, callToAction } = home.data;
const bodyBelow = await renderMarkdown(home.data.bodyBelow);
---

<BaseLayout title={title} description={description}>
<article id="post-home" class="page type-page status-publish hentry">
	<header class="entry-header">
		<h1 class="entry-title">{heading}</h1>
	</header><!-- .entry-header -->

	<div class="noimg"></div>

	<div class="entry-content post-content">
		<Content />
		{callToAction && (
			<div class="action-call">
				<strong set:html={callToAction.split('\n').map((line) => line.replace(/&/g, '&amp;').replace(/</g, '&lt;')).join('<br />')} />
				<div class="action-call__buttons">
					<a class="btn btn--icon" href={telHref(settings.phone)}><i class="icon icon-phone"></i>{settings.phone.replace(/[^\d+]/g, '')}</a>
					<a class="btn btn--icon" href={`mailto:${settings.email}`}><i class="icon icon-mail"></i>{settings.email}</a>
				</div>
			</div>
		)}
		{bodyBelow && (
			<>
				<hr />
				<Fragment set:html={bodyBelow} />
			</>
		)}
	</div><!-- .entry-content -->
</article>
</BaseLayout>
